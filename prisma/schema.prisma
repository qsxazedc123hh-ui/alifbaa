// =====================================================================
// ألف باء - منصة تعليمية عراقية
// Database Schema - v2 (One Page + Trash + Multi-WhatsApp + Messages)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================================
// 1) Admin Authentication
// =====================================================================

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN") // ADMIN | SUPER_ADMIN
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  sessionDurationMins Int @default(60) // configurable session duration
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// =====================================================================
// 2) Brand Identity (Logos + Backgrounds only — NO color editing)
// =====================================================================

model BrandAsset {
  id        String   @id @default(cuid())
  key       String   @unique // logo | logo_dark | logo_light | favicon | bg_light | bg_dark
  label     String
  mediaId   String?
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================================
// 3) Media Library (Centralized)
// =====================================================================

model MediaItem {
  id         String   @id @default(cuid())
  name       String
  altText    String?
  category   String   @default("GENERAL") // LOGOS | BACKGROUNDS | CAMPUS | VIDEOS | GAMES | NEWS | APPS | IMAGES | GENERAL
  mimeType   String
  size       Int      @default(0)
  width      Int?
  height     Int?
  url        String
  thumbnailUrl String?
  duration   Int?     // for videos in seconds
  tags       String?
  metadata   String?  // JSON-encoded extra metadata
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
}

// =====================================================================
// 4) Campus Items (icons inside the campus — content manageable, design fixed)
// =====================================================================

model CampusItem {
  id          String   @id @default(cuid())
  key         String   @unique // smart_battle | videos | news | about | download | contact
  label       String   // اسم العنصر (عربي)
  iconKey     String?  // اسم أيقونة جاهزة من المكتبة
  customMediaId String? // رفع أيقونة/صورة خاصة
  customUrl   String?  // url مباشر (fallback)
  sectionKey  String?  // القسم الداخلي الذي يفتحه (يتم scroll إليه)
  order       Int      @default(0)
  visible     Boolean  @default(true)
  inBottomNav Boolean  @default(false) // يظهر في Bottom Navigation
  bottomNavOrder Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([inBottomNav])
}

// =====================================================================
// 5) Campus Backgrounds (multiple, one active)
// =====================================================================

model CampusBackground {
  id        String   @id @default(cuid())
  label     String
  mediaId   String?
  url       String
  isActive  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================================
// 6) Videos (Smart Battle + General Videos + News Videos)
// =====================================================================

model Video {
  id           String   @id @default(cuid())
  title        String
  description  String?
  type         String   @default("VIDEO") // REEL | VIDEO | GAME | EDUCATIONAL | PROMOTIONAL
  videoUrl     String
  thumbnailUrl String?  // auto-generated from video
  duration     Int?     // seconds
  size         Int      @default(0) // bytes
  mimeType     String?
  section      String   @default("videos") // videos | smart_battle | news
  newsId       String?  // link to News if type=NEWS_VIDEO
  newsItems    News[]   // relation back to News (one video can be used in many news)
  tags         String?
  featured     Boolean  @default(false) // يظهر في الصفحة الرئيسية
  published    Boolean  @default(true)
  order        Int      @default(0)
  publishedAt  DateTime @default(now())
  // Soft delete (Trash)
  deletedAt    DateTime?
  deletedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type, published])
  @@index([section])
  @@index([featured])
  @@index([deletedAt])
}

// =====================================================================
// 7) News (image or video based)
// =====================================================================

model News {
  id           String   @id @default(cuid())
  title        String
  description  String?
  contentType  String   @default("IMAGE") // IMAGE | VIDEO
  imageUrl     String?
  videoId      String?  // link to Video if contentType=VIDEO
  video        Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  featured     Boolean  @default(false) // أحدث خبر بارز
  published    Boolean  @default(true)
  order        Int      @default(0)
  publishedAt  DateTime @default(now())
  // Soft delete
  deletedAt    DateTime?
  deletedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, featured])
  @@index([deletedAt])
  @@unique([videoId])
}

// =====================================================================
// 8) App Downloads (multi-link: APK, Play Store, App Store, Web)
// =====================================================================

model AppLink {
  id        String   @id @default(cuid())
  name      String   // اسم الرابط (مثال: تحميل Android)
  url       String
  type      String   @default("APK") // APK | PLAY_STORE | APP_STORE | WEB | OTHER
  icon      String?  // icon key
  order     Int      @default(0)
  visible   Boolean  @default(true)
  // Soft delete
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
  @@index([deletedAt])
}

model AppRelease {
  id           String   @id @default(cuid())
  platform     String   @default("ANDROID")
  version      String
  versionCode  Int      @default(1)
  nameAr       String
  nameEn       String
  descriptionAr String?
  descriptionEn String?
  releaseNotesAr String?
  releaseNotesEn String?
  iconMediaId  String?
  apkUrl       String
  fileSize     Int      @default(0)
  published    Boolean  @default(true)
  isLatest     Boolean  @default(false)
  releasedAt   DateTime @default(now())
  // Soft delete
  deletedAt    DateTime?
  deletedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([platform, published, isLatest])
  @@index([deletedAt])
}

// =====================================================================
// 9) WhatsApp Numbers (multi)
// =====================================================================

model WhatsAppNumber {
  id        String   @id @default(cuid())
  name      String   // مثال: الدعم الفني
  number    String   // +964...
  order     Int      @default(0)
  visible   Boolean  @default(true)
  // Soft delete
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
  @@index([deletedAt])
}

// =====================================================================
// 10) Social Links
// =====================================================================

model SocialLink {
  id        String   @id @default(cuid())
  platform  String   // FACEBOOK | INSTAGRAM | TIKTOK | YOUTUBE
  url       String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  // Soft delete
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
  @@index([deletedAt])
}

// =====================================================================
// 11) Contact Messages (from form)
// =====================================================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  contact   String   // phone or email
  message   String
  isRead    Boolean  @default(false)
  readAt    DateTime?
  // Soft delete
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([deletedAt])
}

// =====================================================================
// 12) Site Settings (single row)
// =====================================================================

model SiteSetting {
  id              String   @id @default(cuid())
  key             String   @unique // official_domain | welcome_shown | sound_enabled | ...
  value           String
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// =====================================================================
// 13) Audit Log
// =====================================================================

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  module    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([module, createdAt])
}
