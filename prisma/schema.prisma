// =====================================================================
// ألف باء - منصة تعليمية عراقية
// Alif Baa - Iraqi Educational Platform
// Database Schema - PHASE 1
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================================
// 1) Admin Authentication
// =====================================================================

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN") // ADMIN | SUPER_ADMIN
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// =====================================================================
// 2) Brand Identity (Dynamic Visual Identity)
// =====================================================================

model BrandAsset {
  id        String   @id @default(cuid())
  key       String   @unique // logo | logo_dark | logo_light | favicon | ...
  label     String
  mediaId   String?  // reference to MediaItem
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandColor {
  id        String   @id @default(cuid())
  key       String   @unique // primary | secondary | accent | background | ...
  label     String
  value     String   // hex or oklch
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandSetting {
  id           String   @id @default(cuid())
  key          String   @unique // typography | borderRadius | buttonStyle | cardStyle | shadow | ...
  label        String
  value        String   // JSON-encoded value
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// =====================================================================
// 3) Media Library (Centralized)
// =====================================================================

model MediaItem {
  id         String   @id @default(cuid())
  name       String
  altText    String?
  category   String   @default("GENERAL") // LOGOS | BACKGROUNDS | CAMPUS | VIDEOS | REELS | CLASSES | SUBJECTS | APP_ASSETS | GENERAL
  mimeType   String
  size       Int      @default(0) // bytes
  width      Int?
  height     Int?
  url        String
  thumbnailUrl String?
  tags       String?  // comma separated
  metadata   String?  // JSON-encoded extra metadata
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
}

// =====================================================================
// 4) Homepage CMS (Dynamic Sections)
// =====================================================================

model HomePageSection {
  id         String   @id @default(cuid())
  key        String   @unique // hero | campus | services | grades | smart_battle | videos | app_download | contact
  titleAr    String
  titleEn    String
  visible    Boolean  @default(true)
  order      Int      @default(0)
  data       String   // JSON-encoded section payload
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([order])
}

// =====================================================================
// 5) Classes & Subjects
// =====================================================================

model Grade {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameAr      String
  nameEn      String
  descriptionAr String?
  descriptionEn String?
  coverMediaId String?
  icon        String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects    Subject[]

  @@index([order])
}

model Subject {
  id          String   @id @default(cuid())
  gradeId     String
  slug        String
  nameAr      String
  nameEn      String
  descriptionAr String?
  descriptionEn String?
  coverMediaId String?
  icon        String?
  color       String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grade       Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId, slug])
  @@index([order])
}

// =====================================================================
// 6) Smart Battle (صراع الأذكياء) - Promotional Content
// =====================================================================

model SmartBattleSection {
  id         String   @id @default(cuid())
  key        String   @unique // intro | points | ranking | prizes | rules
  titleAr    String
  titleEn    String
  contentAr  String
  contentEn  String
  mediaId    String?
  visible    Boolean  @default(true)
  order      Int      @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([order])
}

// =====================================================================
// 7) Videos & Reels Manager
// =====================================================================

model Video {
  id           String   @id @default(cuid())
  titleAr      String
  titleEn      String
  descriptionAr String?
  descriptionEn String?
  type         String   @default("VIDEO") // REEL | VIDEO | ANNOUNCEMENT | EDUCATIONAL | PROMOTIONAL
  thumbnailMediaId String?
  videoUrl     String
  externalUrl  String?
  tags         String?
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  publishedAt  DateTime @default(now())
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([published])
  @@index([featured])
}

// =====================================================================
// 8) App Downloads (APK / Future Stores)
// =====================================================================

model AppRelease {
  id           String   @id @default(cuid())
  platform     String   @default("ANDROID") // ANDROID | IOS
  version      String
  versionCode  Int      @default(1)
  nameAr       String
  nameEn       String
  descriptionAr String?
  descriptionEn String?
  releaseNotesAr String?
  releaseNotesEn String?
  iconMediaId  String?
  apkUrl       String
  fileSize     Int      @default(0)
  published    Boolean  @default(true)
  isLatest     Boolean  @default(false)
  releasedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([platform, published, isLatest])
}

// =====================================================================
// 9) Contact Settings
// =====================================================================

model ContactSetting {
  id        String   @id @default(cuid())
  key       String   @unique // whatsapp | phone | email | facebook | instagram | tiktok | youtube | telegram | address
  label     String
  value     String
  visible   Boolean  @default(true)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([order])
}

// =====================================================================
// 10) SEO Settings
// =====================================================================

model SeoSetting {
  id              String   @id @default(cuid())
  key             String   @unique // meta_title | meta_description | og_image | canonical | sitemap_url | robots_txt
  valueAr         String?
  valueEn         String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// =====================================================================
// 11) Navigation Manager
// =====================================================================

model NavItem {
  id         String   @id @default(cuid())
  labelAr    String
  labelEn    String
  href       String
  icon       String?
  visible    Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
}

// =====================================================================
// 12) General Site Settings
// =====================================================================

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique // site_name | default_lang | default_theme | ...
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// =====================================================================
// 13) Audit Log (Admin Activity)
// =====================================================================

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT
  module    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([module, createdAt])
}
